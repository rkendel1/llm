{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"],
    "paths": {
      "@llm/secrets": ["./packages/secrets/src/index.ts"],
      "@llm/registry": ["./packages/registry/src/index.ts"],
      "@llm/router": ["./packages/router/src/index.ts"],
      "@llm/core": ["./packages/core/src/index.ts"],
      "@llm/cli": ["./packages/cli/src/index.ts"],
      "@llm/providers": ["./packages/providers/src/index.ts"],
      "@llm/proxy": ["./packages/proxy/src/index.ts"]
    }
  },
  "include": ["src", "packages/*/src", "test"]
}
