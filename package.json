{
  "name": "@easy-llm/llm",
  "version": "0.1.2",
  "description": "Provider-agnostic LLM runtime, routing, and model registry",
  "files": [
    "dist",
    "registry/registry-snapshot.json"
  ],
  "main": "dist/src/index.js",
  "bin": {
    "llm": "dist/packages/cli/src/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    },
    "./secrets": {
      "import": "./dist/packages/secrets/src/index.js",
      "types": "./dist/packages/secrets/src/index.d.ts"
    },
    "./registry": {
      "import": "./dist/packages/registry/src/index.js",
      "types": "./dist/packages/registry/src/index.d.ts"
    },
    "./router": {
      "import": "./dist/packages/router/src/index.js",
      "types": "./dist/packages/router/src/index.d.ts"
    },
    "./cli": {
      "import": "./dist/packages/cli/src/index.js",
      "types": "./dist/packages/cli/src/index.d.ts"
    },
    "./providers": {
      "import": "./dist/packages/providers/src/index.js",
      "types": "./dist/packages/providers/src/index.d.ts"
    },
    "./proxy": {
      "import": "./dist/packages/proxy/src/index.js",
      "types": "./dist/packages/proxy/src/index.d.ts"
    },
    "./registry-ingest": {
      "import": "./dist/packages/registry-ingest/src/index.js",
      "types": "./dist/packages/registry-ingest/src/index.d.ts"
    },
    "./registry-snapshot": {
      "default": "./registry/registry-snapshot.json"
    }
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "ingest:registry": "node dist/packages/registry-ingest/src/cli.js",
    "registry:report": "node dist/packages/registry-ingest/src/cli.js --report",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rkendel1/llm.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "keywords": [
    "llm",
    "ai",
    "openai",
    "anthropic",
    "gemini",
    "openrouter",
    "model-router",
    "model-registry"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "module": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
